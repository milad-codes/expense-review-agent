# Copy to .env (never commit real keys)
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=                     # a current model id of that provider
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
REVIEW_API_TOKEN=change-me-to-a-long-random-token
DATA_DIR=./data
PORT=3000
LOG_LEVEL=info
# Optional LangSmith tracing of every graph run:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=expense-review-agent
