{
  "name": "expense-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.8.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "description": "LangGraph.js agent that reviews expense claims with deterministic policy tools and human-in-the-loop approvals",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  }
}
